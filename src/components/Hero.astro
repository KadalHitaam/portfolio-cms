---
// Hero.astro - Static portfolio hero component
---

<section class="min-h-screen flex items-center py-20" style="background-color: var(--nb-bg);">
  <div class="max-w-6xl mx-auto px-6 w-full">
    <!-- Grid: 2 cols desktop, 1 col mobile -->
    <div class="grid grid-cols-1 md:grid-cols-[1fr_1fr] gap-12 items-center">
      
      <!-- Left Column: Text & CTA -->
      <div class="flex flex-col justify-center nb-animate-in">
        
        <!-- Status Badge -->
        <div class="inline-flex w-fit mb-6">
          <span class="nb-badge" style="background-color: var(--nb-mint);">
            ● Open for Internships & Networking
          </span>
        </div>

        <!-- Headline -->
        <h1 class="text-5xl md:text-7xl font-extrabold tracking-tight leading-[0.95]" style="font-family: var(--font-heading); color: var(--nb-ink);">
          Naufal<br/>
          <span style="background: var(--nb-yellow); padding: 0 0.25em; border: 3px solid var(--nb-ink); display: inline-block; transform: rotate(-1deg);">Alexander</span>
        </h1>

        <!-- Role/Tagline -->
        <p class="text-xl md:text-2xl font-bold mt-5" style="color: var(--nb-ink-soft); font-family: var(--font-heading);">
          Informatics Engineering Student<br class="hidden md:block"/> | Web Development Enthusiast
        </p>

        <!-- Bio -->
        <p class="text-base md:text-lg mt-6 max-w-2xl leading-relaxed" style="color: var(--nb-ink-muted);">
          Mahasiswa Teknik Informatika yang berfokus pada pengembangan perangkat lunak dengan aspirasi karir sebagai Software Engineer. Berkomitmen membangun sistem yang bersih serta mendokumentasikan setiap proses pembelajaran secara konsisten.
        </p>

        <!-- CTA Buttons -->
        <div class="flex flex-wrap gap-4 mt-8">
          <a
            href="https://github.com/KadalHitaam", target="_blank"
            class="nb-btn nb-btn-primary"
          >
            ↗ Lihat Repositori
          </a>
          <a
            href="#notes"
            class="nb-btn nb-btn-secondary"
          >
            ↓ Jelajahi Catatan
          </a>
        </div>
      </div>

      <!-- Right Column: Profile Image -->
      <div class="flex justify-center md:justify-end">
        <div class="w-64 h-64 md:w-80 md:h-80 overflow-hidden" style="border: 4px solid var(--nb-ink); box-shadow: 8px 8px 0px var(--nb-ink); transform: rotate(2deg);">
          <img src="/profile.jpg" alt="Profile Naufal" class="w-full h-full object-cover" />
        </div>
      </div>

    </div>
  </div>
</section>
