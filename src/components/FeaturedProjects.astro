---
// FeaturedProjects.astro | Static project showcase component

const projects = [
  {
    title: "Bio-Link Microsite & Dashboard Manager",
    tagline: "Centralized Link Management with Admin Analytics",
    image: "/microsite.gif",
    description: "Platform untuk merangkum banyak tautan media sosial dalam satu halaman terpusat. Dilengkapi dasbor admin interaktif untuk mengelola daftar link dan memantau pengalihan URL secara dinamis.",
    stack: ["PHP", "Laravel", "Blade", "Tailwind CSS", "MySQL", "Eloquent ORM"],
    actionLabel: "View Repository & Architecture",
    repoUrl: "https://github.com/KadalHitaam/microsite.git",
    imagePlaceholder: "https://placehold.co/800x450/18181b/ffffff?text=Bio-Link+Dashboard",
    accent: "var(--nb-pink)"
  },
  {
    title: "Sistem Monitoring & Transaksi Fotokopi",
    tagline: "Streamlined Transaction & Cashflow Tracker",
    image: "/fotocopy.gif",
    description: "Sistem pencatatan keuangan untuk mempermudah pemilik bisnis dan kasir dalam melacak pengeluaran serta pemasukan harian secara terstruktur, meminimalkan risiko selisih pembukuan manual.",
    stack: ["TypeScript", "Next.js", "Prisma ORM", "MySQL", "Tailwind CSS"],
    actionLabel: "View Repository & Database Schema",
    repoUrl: "https://github.com/KadalHitaam/monitor-fotocopy.git",
    imagePlaceholder: "https://placehold.co/800x450/18181b/ffffff?text=Sistem+Fotokopi",
    accent: "var(--nb-blue)"
  }
  
];

// Alternating badge colors for tech stack
const badgeColors = ['var(--nb-yellow)', 'var(--nb-mint)', 'var(--nb-pink)', 'var(--nb-blue)', 'var(--nb-lavender)', 'var(--nb-orange)'];
---

<section id="projects" class="max-w-6xl mx-auto px-6 py-16">
  <!-- Section Header -->
  <h2 class="nb-section-title">Featured Projects</h2>
  <p class="mt-3 mb-10" style="color: var(--nb-ink-muted); font-size: 1.05rem;">Building clean systems and practical solutions.</p>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {projects.map((project, projectIdx) => (
      <article class="nb-card overflow-hidden flex flex-col">
        <!-- Project Image -->
        <div style={`border-bottom: 3px solid var(--nb-ink);`}>
          <img
            src={project.image}
            alt={project.title}
            class="w-full h-60 object-cover"
          />
        </div>

        <!-- Content Area -->
        <div class="p-6 flex flex-col flex-1">
          <!-- Tagline bar -->
          <div class="mb-3 -mt-1">
            <span
              class="inline-block text-xs font-bold uppercase tracking-wider px-3 py-1"
              style={`background-color: ${project.accent}; border: 2px solid var(--nb-ink); font-family: var(--font-mono);`}
            >
              {project.tagline}
            </span>
          </div>

          <h3 class="text-xl font-bold mb-3" style="color: var(--nb-ink); font-family: var(--font-heading);">{project.title}</h3>
          <p class="text-sm mb-6 line-clamp-3" style="color: var(--nb-ink-muted);">{project.description}</p>

          <!-- Tech Stack Badges -->
          <div class="flex flex-wrap gap-2 mb-6">
            {project.stack.map((tech, i) => (
              <span
                class="text-xs px-2.5 py-1 font-bold"
                style={`background-color: ${badgeColors[i % badgeColors.length]}; border: 2px solid var(--nb-ink); font-family: var(--font-mono);`}
              >
                {tech}
              </span>
            ))}
          </div>

          <!-- Action Button -->
          <div class="mt-auto">
            <a
              href={project.repoUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="nb-btn nb-btn-primary text-xs"
            >
              ↗ View Repository
            </a>
          </div>
        </div>
      </article>
    ))}
  </div>
</section>
