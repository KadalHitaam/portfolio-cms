---
// FeaturedProjects.astro - Static project showcase component

const projects = [
  {
    title: "Bio-Link Microsite & Dashboard Manager",
    tagline: "Centralized Link Management with Admin Analytics",
    image: "./public/microsite.gif",
    description: "Platform untuk merangkum banyak tautan media sosial dalam satu halaman terpusat. Dilengkapi dasbor admin interaktif untuk mengelola daftar link dan memantau pengalihan URL secara dinamis.",
    stack: ["PHP", "Laravel", "Blade", "Tailwind CSS", "MySQL", "Eloquent ORM"],
    actionLabel: "View Repository & Architecture",
    repoUrl: "https://github.com/KadalHitaam/microsite.git",
    imagePlaceholder: "https://placehold.co/800x450/18181b/ffffff?text=Bio-Link+Dashboard"
  },
  {
    title: "Sistem Monitoring & Transaksi Fotokopi",
    tagline: "Streamlined Transaction & Cashflow Tracker",
    image: "./public/fotocopy.gif",
    description: "Sistem pencatatan keuangan untuk mempermudah pemilik bisnis dan kasir dalam melacak pengeluaran serta pemasukan harian secara terstruktur, meminimalkan risiko selisih pembukuan manual.",
    stack: ["TypeScript", "Next.js", "Prisma ORM", "MySQL", "Tailwind CSS"],
    actionLabel: "View Repository & Database Schema",
    repoUrl: "https://github.com/KadalHitaam/monitor-fotocopy.git",
    imagePlaceholder: "https://placehold.co/800x450/18181b/ffffff?text=Sistem+Fotokopi"
  }
  
];
---

<section id="projects" class="max-w-6xl mx-auto px-6 py-16">
  <!-- Section Header -->
  <h2 class="text-3xl font-bold text-white mb-2">Featured Projects</h2>
  <p class="text-gray-400 mb-10">Building clean systems and practical solutions.</p>

  <!-- Projects Grid -->
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8">
    {projects.map((project) => (
      <article class="bg-zinc-900 border border-zinc-800 rounded-xl overflow-hidden hover:border-zinc-700 transition-colors">
        <!-- Project Image -->
        <img
          src={project.image}
          alt={project.title}
          class="w-full h-60 object-cover"
        />


        <!-- Content Area -->
        <div class="p-6">
          <h3 class="text-xl font-bold text-white mb-1">{project.title}</h3>
          <p class="text-sm font-medium text-emerald-400 mb-4">{project.tagline}</p>
          <p class="text-sm text-gray-400 mb-6 line-clamp-3">{project.description}</p>

          <!-- Tech Stack Badges -->
          <div class="flex flex-wrap gap-2 mb-6">
            {project.stack.map((tech) => (
              <span class="text-xs px-2.5 py-0.5 rounded-full bg-zinc-800 text-gray-300 border border-zinc-700">
                {tech}
              </span>
            ))}
          </div>

          <!-- Action Button -->
          <a
            href={project.repoUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2 px-4 py-2 text-sm font-medium transition-colors border rounded-md hover:bg-gray-100 border-gray-300 ..."
            >
            View Repository
          </a>
          
        </div>
      </article>
    ))}
  </div>
</section>
