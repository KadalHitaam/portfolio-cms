---
import '../styles/global.css';
// Set Edge Cache pada Cloudflare
Astro.response.headers.set(
  'Cache-Control',
  'public, max-age=0, s-maxage=600, stale-while-revalidate=3600'
);
import Hero from '../components/Hero.astro';
import GithubGrid from '../components/GithubGrid.jsx';
import FeaturedProjects from '../components/FeaturedProjects.astro';
import LearningVault from '../components/LearningVault.jsx';
import { getLearningNotes } from '../lib/notion.js';

const notes = await getLearningNotes();
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Naufal Alexander</title>
    <meta
      name="description"
      content="Portfolio and documentation site for full-stack web development, featuring project showcases and personal learning checkpoints."
    />
  </head>
  <body class="min-h-screen" style="background-color: var(--nb-bg); color: var(--nb-ink); font-family: var(--font-body);">

    <Hero />
    <GithubGrid client:only="react" />
    <FeaturedProjects />
    <LearningVault notes={notes} client:load />
  </body>
</html>
